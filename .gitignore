# Machine-local overrides. Anything in here is ignored by git, so each device
# can differ without causing conflicts. lazy.nvim still imports the file if it
# exists (see lua/config/lazy.lua), so use it for per-machine plugin tweaks.
lua/plugins/local.lua
lua/config/local.lua

# Spell files downloaded on demand
spell/

