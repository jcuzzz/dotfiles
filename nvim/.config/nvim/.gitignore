# Machine-local overrides, so each device can differ without merge conflicts.
#
#   lua/config/local.lua    editor settings for this machine only; init.lua
#                           requires it if present
#   lua/plugins/local.lua   extra plugins for this machine only; lazy.nvim
#                           imports the whole lua/plugins/ directory, so this
#                           is picked up automatically
lua/config/local.lua
lua/plugins/local.lua

# Spell files downloaded on demand
spell/

# Generated by some LSP/editor tooling
.luarc.json
